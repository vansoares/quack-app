# Ao rodar `vercel dev` localmente com o projeto já linkado, rode
# `vercel env pull .env.local` para baixar estas variáveis automaticamente
# (a integração de Redis do Vercel preenche UPSTASH_* sozinha).
#
# Gere o JWT_SECRET com: openssl rand -hex 32

JWT_SECRET=

# Preenchidas automaticamente ao conectar uma integração de Redis
# (Vercel Marketplace → Upstash) — normalmente não precisa copiar à mão.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Necessária para o fluxo de "esqueci minha senha" enviar o e-mail de
# redefinição. Crie uma conta grátis em resend.com e gere uma API key.
RESEND_API_KEY=

# Opcional — remetente usado nesses e-mails. Sem domínio verificado na
# Resend, e-mails só chegam ao endereço com que você criou a conta lá;
# verifique um domínio em resend.com/domains para atender qualquer pessoa.
RESEND_FROM=

# Opcional — só essa conta enxerga a página de admin (/api/admin/*). Sem
# configurar, o padrão já é vanessa.ssoares.vs@gmail.com.
ADMIN_EMAIL=
